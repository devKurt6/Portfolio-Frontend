{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["app.mjs", "components/**/*.mjs", "pages/**/*.mjs", "hooks/**/*.mjs", "lib/**/*.mjs", "services/**/*.mjs", "types/**/*.d.ts"]
}
